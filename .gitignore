tests/ppsspp/**/*.PBP
tests/ppsspp/**/*.prx
tests/ppsspp/**/*.SFO
tests/ppsspp/**/result.txt
tests/ppsspp/**/server.log
build-host-tests

# Ignore documentation directory
doc/html

# Ignore submodule libraries
lib/libpspmath/*.a
lib/libintraFont/*.a

# Ignore release artifacts
dist/
OSLib.zip

# CMake
compile_commands.json
install_manifest.txt
cmake_install.cmake
CMakeFiles/
