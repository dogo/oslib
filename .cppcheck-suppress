# Cppcheck suppressions for OSLib.
#
# The analysis runs against compile_commands.json, which covers lib/ as well as
# src/, so the third-party entries below are load-bearing: without them the
# vendored sources would dominate the output.

# Third-party libraries that we don't modify
*:lib/giflib/*
*:lib/libintraFont/*
*:lib/libpspmath/*
*:tools/src/wav2bgm/*

# src/vfpu.c uses GCC's explicit-register syntax to pin a variable to $a0:
#
#     register void *ptr __asm("a0") = vfpu_vars;
#
# Cppcheck's parser does not accept it and aborts the file with a syntaxError,
# which would otherwise mask every real finding in it. This is a parser
# limitation, not a defect; drop this line if cppcheck ever learns the syntax.
syntaxError:src/vfpu.c
